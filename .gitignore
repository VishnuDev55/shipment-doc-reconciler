# Secrets — never commit
.env
*.env.local

# Runtime state (the filesystem database)
runs/
dist/

# Generated by scripts/build_fixtures.py, but COMMITTED on purpose: it is what
# makes DEMO_MODE work with no API key. Only ignore accidental live writes that
# do not belong in the repo.
# (fixtures/images and fixtures/responses are tracked — do not add them here.)

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local-only output of the dev tools declared in requirements-dev.txt. None of
# these are artifacts to commit: mypy/ruff caches are regenerable keyed on
# content, and .coverage/htmlcov is a snapshot of one machine's run. The
# reproducibility record that IS committed is requirements.lock.txt.
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Browser-test output (tests_e2e/). Generated per run; the tests themselves are
# committed, their screenshots and playwright reports are not.
test-results/
playwright-report/

# Editors / OS
.vscode/
.idea/
.DS_Store

# scratch from scripts/live_compare.py
.live_runcache/

# Where a live run's captured responses land. Tracked fixtures are reviewed
# provenance; a model's answer about somebody's real shipment is not, and this
# is the directory that keeps the two apart. See Settings.live_cache_dir.
.live_cache/

.probe_cache/

# Output of the /brag skill (rendered video, frame dumps, composition).
brag-output/
brag-output-*/

# Local tooling output and hand-off notes — not project files.
graphify-out/
.freebuff/
HANDOFF.md

# Rasterised PDF pages written only when a layout test fails (CI uploads them).
tests/artifacts/
