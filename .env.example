# =============================================================================
# Two providers, two keys. Copy to .env. Never commit .env.
#
#   VISION   (document extraction)  -> NVIDIA build.nvidia.com  [primary path]
#   SUMMARY  (executive paragraph) -> Nebius Token Factory     [required by the
#                                     hackathon brief]
# =============================================================================

# --- NVIDIA build.nvidia.com -------------------------------------------------
# Get a key: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=your-api-key-here
# Verified live: GET https://integrate.api.nvidia.com/v1/models -> 200
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/
# Leave blank for the default (verified working). Override only to change model.
NVIDIA_VISION_MODEL=

# --- Nebius Token Factory ----------------------------------------------------
# Get a key: https://tokenfactory.nebius.com/project/api-keys
NEBIUS_API_KEY=your-api-key-here
# Verified against the official docs quickstart and api-reference/introduction.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Nemotron text model for the executive summary. Blank = default
# (nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B, verified live).
NEBIUS_SUMMARY_MODEL=
# Only used when VISION_PROVIDER=nebius. Blank = openbmb/MiniCPM-V-4_5.
NEBIUS_VISION_MODEL=

# --- Model discovery ---------------------------------------------------------
# Before a run extracts, ask each host GET /v1/models and confirm the configured
# name is actually served. If it is not, adopt a model the host does serve rather
# than failing every document — this already bit once: the brief's
# nvidia/Nemotron-Nano-12B-V2-VL returned 410 Gone on build.nvidia.com.
# Skipped entirely in DEMO_MODE (no key, nothing to discover).
MODEL_DISCOVERY=true
MODEL_DISCOVERY_TTL_SECONDS=900
# Comma-separated names you trust over both the defaults and discovery. A human
# naming a model is a decision, not a guess, so it wins.
VISION_MODEL_ALLOW=
SUMMARY_MODEL_ALLOW=

# --- Routing -----------------------------------------------------------------
# nvidia = build.nvidia.com (default, primary).
# nebius = MiniCPM-V on Token Factory, a fallback if the NVIDIA key is missing
#          or its shared workers stay saturated (it returns 503s under load).
VISION_PROVIDER=nvidia

# Set to false (the default) to call the live APIs. With true, extractions and
# summaries are replayed from fixtures/responses/ and no network call is made —
# that is the keyless demo path, not the normal one.
DEMO_MODE=false

# The AI executive summary is optional and can never fail a shipment.
ENABLE_SUMMARY=true
# A model's opinion on comparisons the deterministic engine called ambiguous
# (party names in the 70-89 similarity band, and unclear quantity bases), and a
# draft supplier email written from the verdicts. Both are additive: neither can
# change a status, a verdict or a shipment state. Skipped in DEMO_MODE, because
# a hand-authored "opinion" would be a fake result.
ENABLE_ADJUDICATION=true
ENABLE_BRIEFING=true
# Read every page with a SECOND provider and mark the fields the two readers did
# not agree on as "needs review". Off by default: it roughly doubles the token
# spend of a run, and agreement between two models is not proof either.
CONSENSUS=false
# nvidia | nebius | blank = whichever provider the primary run is not using.
CONSENSUS_PROVIDER=

# Let the web UI apply keys and demo mode to the running process (Configure
# panel). Such a key then serves every visitor, so set this to false on a
# public deployment and keep keys as environment variables there.
GUI_CONFIG_ENABLED=true
# Optional shared secret for GET/POST /api/config, sent as X-Config-Token.
# Without it there are no user sessions, so anyone who can reach the port can
# replace the keys every visitor shares. Leave blank for local single-user use.
# On a public host prefer GUI_CONFIG_ENABLED=false; set a token only if you want
# to keep configuring it remotely.
CONFIG_TOKEN=

# Comma-separated keys that expose the app as a keyed service instead of an open
# demo. With any value here, every data-bearing route needs X-API-Key (or
# Authorization: Bearer) and only /api/health answers to strangers. Blank means
# open: correct for a laptop, wrong for anything reachable by others, because a
# shipment report is other people's commercial data. See docs/API.md.
API_KEYS=

# --- Tuning ------------------------------------------------------------------
RUNS_DIR=./runs
CACHE_DIR=./fixtures/responses
MAX_DOCUMENTS=5
MAX_PAGES_PER_DOCUMENT=6
IMAGE_LONG_EDGE=1600
JPEG_QUALITY=85
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=180
# Blended price per million tokens, used only to annotate the Transparency
# panel. Left at 0 the panel shows token counts and refuses to print a cost,
# because a guessed or stale rate on an audit screen is worse than none.
USD_PER_MTOK=0
